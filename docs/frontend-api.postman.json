{
  "info": {
    "name": "ATS API v2 (Auth + RBAC)",
    "description": "ATS Resume Analyzer — all endpoints with JWT auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "jd_id",
      "value": ""
    },
    {
      "key": "resume_id",
      "value": ""
    },
    {
      "key": "analysis_id",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "skill_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login → Save Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "  pm.collectionVariables.set('token', json.access_token);",
                  "  console.log('Token saved.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ats-system.com\",\n  \"password\": \"admin1234\"\n}"
            }
          }
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/logout",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Users (Admin)",
      "item": [
        {
          "name": "POST /users — Create HR",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('user_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/users",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hr@company.com\",\n  \"password\": \"hrpassword\",\n  \"role\": \"hr\"\n}"
            }
          }
        },
        {
          "name": "GET /users",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "GET /users/:id",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/{{user_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "PATCH /users/:id",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/users/{{user_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"admin\",\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "DELETE /users/:id (deactivate)",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/users/{{user_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "GET /users/:id/permissions",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/{{user_id}}/permissions",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "PUT /users/:id/permissions",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/users/{{user_id}}/permissions",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permission_codes\": [\"taxonomy.manage\", \"logs.view\"]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Job Descriptions",
      "item": [
        {
          "name": "POST /job-descriptions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('jd_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/job-descriptions",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Senior Python Engineer\",\n  \"raw_text\": \"5+ years of Python experience. FastAPI, PostgreSQL, Docker required.\"\n}"
            }
          }
        },
        {
          "name": "GET /job-descriptions/:id",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/job-descriptions/{{jd_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Resumes",
      "item": [
        {
          "name": "POST /resumes (upload)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('resume_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/resumes",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            }
          }
        },
        {
          "name": "GET /resumes/:id",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/resumes/{{resume_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "DELETE /resumes/:id",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/resumes/{{resume_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Analyses",
      "item": [
        {
          "name": "POST /analyses",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('analysis_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/analyses",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resume_id\": {{resume_id}},\n  \"job_description_id\": {{jd_id}}\n}"
            }
          }
        },
        {
          "name": "GET /analyses/:id",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/analyses/{{analysis_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "GET /results?job_description_id=",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/results?job_description_id={{jd_id}}",
              "query": [
                {
                  "key": "job_description_id",
                  "value": "{{jd_id}}"
                }
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Taxonomy",
      "item": [
        {
          "name": "GET /taxonomy/skills",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/taxonomy/skills?is_active=true",
              "query": [
                {
                  "key": "q",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "category",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "is_active",
                  "value": "true"
                }
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "POST /taxonomy/skills",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('skill_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/taxonomy/skills",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"FastAPI\",\n  \"category\": \"Backend\",\n  \"aliases\": [\"fast-api\"]\n}"
            }
          }
        },
        {
          "name": "PATCH /taxonomy/skills/:id",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/taxonomy/skills/{{skill_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"Python\",\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "DELETE /taxonomy/skills/:id",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/taxonomy/skills/{{skill_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Audit Logs (Admin)",
      "item": [
        {
          "name": "GET /logs/audit",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/logs/audit?limit=50",
              "query": [
                {
                  "key": "action",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "entity_type",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "actor_user_id",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "date_from",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "date_to",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "disabled": true
                }
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Health (Public)",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        }
      ]
    }
  ]
}